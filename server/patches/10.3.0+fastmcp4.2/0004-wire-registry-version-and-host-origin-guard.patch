+def _is_loopback_bind_host(host: str | None) -> bool:
+    h = (host or "").strip().strip("[]").lower()
+    return h == "localhost" or h == "::1" or h.startswith("127.")
+
+
+def _host_origin_protection_setting(bind_host: str | None) -> bool | str:
+    """FastMCP 4's Host/Origin guard for the HTTP transport (DNS-rebinding protection).
+
+    Loopback bind (the default 127.0.0.1): "auto" -- loopback Host values and absent/loopback
+    Origins pass, so Claude Code and the Unity Editor on the same machine are unaffected, while a
+    browser page from another origin is refused (403/421). Any other bind (0.0.0.0/:: from the
+    Unity package's LAN option, or a LAN address): off, as upstream; the user chose to expose the
+    server and clients then use whatever Host they were configured with (0.0.0.0 included).
+    UNITY_MCP_HTTP_HOST_ORIGIN_PROTECTION=auto|true|false overrides both. The guard covers HTTP
+    scopes only; the /hub/plugin WebSocket is not subject to it.
+    """
+    raw = os.environ.get("UNITY_MCP_HTTP_HOST_ORIGIN_PROTECTION", "").strip().lower()
+    if raw in ("1", "true", "yes", "on", "strict"):
+        return True
+    if raw in ("0", "false", "no", "off"):
+        return False
+    if raw == "auto":
+        return "auto"
+    return "auto" if _is_loopback_bind_host(bind_host) else False
+
