--- /dev/null
+++ b/tests/test_fastmcp4_port.py
@@ -0,0 +1,374 @@
+"""Unit tests for the FastMCP 4 / MCP SDK 2 port (10.3.0+fastmcp4.x).
+
+Covers the pieces that replaced FastMCP 3 internals: connection tracking for
+``tools/list_changed``, the selection scope that decides where ``set_active_instance``
+can store a choice, and the scope-aware refusal returned to 2026-07-28 clients.
+"""
+from __future__ import annotations
+
+import asyncio
+import sys
+from contextlib import AsyncExitStack
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from transport import mcp_client_registry
+
+# tests/integration/conftest.py replaces ``mcp`` with a bare stub module when ``mcp.types`` was not
+# imported before it ran, and a stub cannot provide ``mcp.server.subscriptions``. The two tests that
+# need the real SDK are then skipped here; the live transport test (a subprocess with a clean module
+# space) covers the same code against the real SDK.
+_MCP_IS_STUBBED = getattr(sys.modules.get("mcp"), "__path__", None) is None
+needs_real_sdk = pytest.mark.skipif(_MCP_IS_STUBBED, reason="mcp package stubbed by tests/integration/conftest.py")
+from transport.unity_instance_middleware import UnityInstanceMiddleware
+
+
+HANDSHAKE = "2025-06-18"
+MODERN = "2026-07-28"
+
+
+class _Connection:
+    """Stand-in for mcp.server.connection.Connection."""
+
+    def __init__(self, *, standalone: bool, session_id=None, initialized=True, protocol_version=HANDSHAKE):
+        self.has_standalone_channel = standalone
+        self.session_id = session_id
+        self.protocol_version = protocol_version
+        self.exit_stack = AsyncExitStack()
+        self.initialized = asyncio.Event()
+        if initialized:
+            self.initialized.set()
+        self.send_tool_list_changed = AsyncMock()
+        self.state: dict = {}
+
+
+class _Ctx:
+    """Stand-in for fastmcp.server.context.Context: request_context.session._connection + state."""
+
+    def __init__(self, connection=None, client_id=None, user_id=None):
+        session = SimpleNamespace(_connection=connection)
+        self.request_context = SimpleNamespace(session=session, meta=None)
+        self._session = session
+        self.client_id = client_id
+        self._state: dict = {}
+        self._request_state: dict = {}
+        if user_id is not None:
+            self._request_state["user_id"] = user_id
+
+    async def set_state(self, key, value, *, serializable=True):
+        (self._state if serializable else self._request_state)[key] = value
+
+    async def get_state(self, key):
+        if key in self._request_state:
+            return self._request_state[key]
+        return self._state.get(key)
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry():
+    mcp_client_registry._connections.clear()
+    yield
+    mcp_client_registry._connections.clear()
+
+
+# ---------------------------------------------------------------- registry
+
+
+def test_track_connection_only_keeps_channels_that_can_receive_notifications():
+    legacy_http = _Connection(standalone=True, session_id="abc")
+    stdio = _Connection(standalone=True, session_id=None)
+    single_exchange = _Connection(standalone=False, session_id=None, protocol_version=MODERN)
+    modern_stdio = _Connection(standalone=True, session_id=None, protocol_version=MODERN)
+
+    assert mcp_client_registry.track_connection(legacy_http) is True
+    assert mcp_client_registry.track_connection(stdio) is True
+    assert mcp_client_registry.track_connection(single_exchange) is False
+    assert mcp_client_registry.track_connection(modern_stdio) is False  # per-request, notify-only channel
+    assert mcp_client_registry.track_connection(legacy_http) is False  # idempotent
+    assert mcp_client_registry.track_connection(None) is False
+    assert mcp_client_registry.tracked_connection_count() == 2
+
+
+@pytest.mark.asyncio
+async def test_connection_is_forgotten_when_its_exit_stack_unwinds():
+    conn = _Connection(standalone=True, session_id="abc")
+    mcp_client_registry.track_connection(conn)
+    assert mcp_client_registry.tracked_connection_count() == 1
+    await conn.exit_stack.aclose()  # what the SDK does when the client session ends
+    assert mcp_client_registry.tracked_connection_count() == 0
+
+
+@pytest.mark.asyncio
+async def test_middleware_tracks_the_connection_behind_the_fastmcp_context():
+    conn = _Connection(standalone=True, session_id="abc")
+    ctx = _Ctx(conn)
+    mw = mcp_client_registry.McpClientTrackingMiddleware()
+    context = SimpleNamespace(fastmcp_context=ctx, method="initialize")
+    called = []
+
+    async def call_next(c):
+        called.append(c)
+        return "result"
+
+    assert await mw.on_message(context, call_next) == "result"
+    assert called == [context]
+    assert mcp_client_registry.tracked_connection_count() == 1
+
+    # No context / no connection must never break the chain.
+    assert await mw.on_message(SimpleNamespace(fastmcp_context=None, method="x"), call_next) == "result"
+
+
+@needs_real_sdk
+@pytest.mark.asyncio
+async def test_notify_sends_to_initialized_connections_and_publishes_to_the_bus():
+    ready = _Connection(standalone=True, session_id="s1")
+    not_ready = _Connection(standalone=True, session_id="s2", initialized=False)
+    failing = _Connection(standalone=True, session_id="s3")
+    failing.send_tool_list_changed = AsyncMock(side_effect=RuntimeError("gone"))
+    for c in (ready, not_ready, failing):
+        mcp_client_registry.track_connection(c)
+
+    events = []
+    unsubscribe = mcp_client_registry.subscription_bus().subscribe(events.append)
+    try:
+        notified = await mcp_client_registry.notify_tools_list_changed()
+    finally:
+        unsubscribe()
+
+    assert notified == 1
+    ready.send_tool_list_changed.assert_awaited_once()
+    not_ready.send_tool_list_changed.assert_not_awaited()
+    assert len(events) == 1 and type(events[0]).__name__ == "ToolsListChanged"
+
+
+@needs_real_sdk
+def test_install_registers_middleware_and_listen_handler_once():
+    from mcp.types import SubscriptionsListenRequestParams
+
+    handlers: dict = {}
+
+    class LowLevel:
+        def get_request_handler(self, method):
+            return handlers.get(method)
+
+        def add_request_handler(self, method, params_type, handler):
+            handlers[method] = (params_type, handler)
+
+    class Server:
+        def __init__(self):
+            self.middleware = []
+            self._mcp_server = LowLevel()
+
+        def add_middleware(self, mw):
+            self.middleware.append(mw)
+
+    server = Server()
+    mcp_client_registry.install(server)
+    mcp_client_registry.install(server)  # second call is a no-op
+    assert len(server.middleware) == 1
+    assert isinstance(server.middleware[0], mcp_client_registry.McpClientTrackingMiddleware)
+    params_type, handler = handlers[mcp_client_registry.LISTEN_METHOD]
+    assert params_type is SubscriptionsListenRequestParams
+    assert type(handler).__name__ == "ListenHandler"
+
+
+# ---------------------------------------------------------------- selection scope
+
+
+@pytest.mark.parametrize(
+    "connection,client_id,expected",
+    [
+        (None, None, ("session", None)),                                                        # test shims / in-memory
+        (_Connection(standalone=True, session_id="http-session"), None, ("session", None)),    # handshake HTTP
+        (_Connection(standalone=True, session_id=None), None, ("session", None)),              # handshake stdio
+        (_Connection(standalone=False, session_id=None, protocol_version=MODERN), "cid-1", ("client", "cid-1")),  # 2026-07-28 HTTP + client_id
+        (_Connection(standalone=False, session_id=None, protocol_version=MODERN), "  ", (None, None)),            # blank client_id
+        (_Connection(standalone=False, session_id=None, protocol_version=MODERN), None, (None, None)),            # 2026-07-28 HTTP, anonymous
+        (_Connection(standalone=True, session_id=None, protocol_version=MODERN), None, (None, None)),             # 2026-07-28 stdio (notify-only channel)
+        (_Connection(standalone=True, session_id=None, protocol_version=MODERN), "cid-2", ("client", "cid-2")),   # 2026-07-28 stdio + client_id
+    ],
+)
+def test_selection_scope_matrix(connection, client_id, expected):
+    mw = UnityInstanceMiddleware()
+    assert mw.selection_scope(_Ctx(connection, client_id)) == expected
+    assert mw.can_persist_selection(_Ctx(connection, client_id)) == (expected[0] is not None)
+
+
+@pytest.mark.asyncio
+async def test_session_scope_uses_fastmcp_state():
+    mw = UnityInstanceMiddleware()
+    ctx = _Ctx(_Connection(standalone=True, session_id="s"))
+    await mw.set_active_instance(ctx, "A@aaaa1111")
+    assert ctx._state[mw._ACTIVE_INSTANCE_STATE_KEY] == "A@aaaa1111"
+    assert await mw.get_active_instance(ctx) == "A@aaaa1111"
+    await mw.clear_active_instance(ctx)
+    assert await mw.get_active_instance(ctx) is None
+
+
+@pytest.mark.asyncio
+async def test_client_scope_is_keyed_by_client_id_and_isolated():
+    mw = UnityInstanceMiddleware()
+    one = _Ctx(_Connection(standalone=False, protocol_version=MODERN), "client-1")
+    two = _Ctx(_Connection(standalone=False, protocol_version=MODERN), "client-2")
+    await mw.set_active_instance(one, "A@aaaa1111")
+    assert await mw.get_active_instance(one) == "A@aaaa1111"
+    assert await mw.get_active_instance(two) is None
+    assert one._state == {}  # nothing went to the throw-away FastMCP session
+    await mw.clear_active_instance(one)
+    assert await mw.get_active_instance(one) is None
+
+
+@pytest.mark.asyncio
+async def test_client_scope_expires(monkeypatch):
+    import transport.unity_instance_middleware as uim
+
+    mw = UnityInstanceMiddleware()
+    ctx = _Ctx(_Connection(standalone=False, protocol_version=MODERN), "client-ttl")
+    now = [1000.0]
+    monkeypatch.setattr(uim.time, "monotonic", lambda: now[0])
+    await mw.set_active_instance(ctx, "A@aaaa1111")
+    now[0] += mw._CLIENT_SELECTION_TTL_SECONDS - 1
+    assert await mw.get_active_instance(ctx) == "A@aaaa1111"
+    now[0] += 2
+    assert await mw.get_active_instance(ctx) is None
+
+
+@pytest.mark.asyncio
+async def test_client_scope_is_separated_per_user_in_remote_hosted_mode(monkeypatch):
+    from core.config import config
+
+    monkeypatch.setattr(config, "http_remote_hosted", True)
+    mw = UnityInstanceMiddleware()
+    alice = _Ctx(_Connection(standalone=False, protocol_version=MODERN), "shared-id", user_id="alice")
+    bob = _Ctx(_Connection(standalone=False, protocol_version=MODERN), "shared-id", user_id="bob")
+    await mw.set_active_instance(alice, "A@aaaa1111")
+    assert await mw.get_active_instance(alice) == "A@aaaa1111"
+    assert await mw.get_active_instance(bob) is None
+
+
+@pytest.mark.asyncio
+async def test_client_table_is_bounded_and_swept(monkeypatch):
+    import transport.unity_instance_middleware as uim
+
+    mw = UnityInstanceMiddleware()
+    monkeypatch.setattr(mw, "_CLIENT_SELECTION_MAX_ENTRIES", 3)
+    now = [0.0]
+    monkeypatch.setattr(uim.time, "monotonic", lambda: now[0])
+    for i in range(5):
+        now[0] += 1
+        await mw.set_active_instance(_Ctx(_Connection(standalone=False, protocol_version=MODERN), f"c{i}"), f"I@{i}")
+    assert [k[1] for k in mw._client_selections] == ["c2", "c3", "c4"]  # oldest dropped first
+    now[0] += mw._CLIENT_SELECTION_TTL_SECONDS + 10
+    await mw.set_active_instance(_Ctx(_Connection(standalone=False, protocol_version=MODERN), "fresh"), "I@x")
+    assert [k[1] for k in mw._client_selections] == ["fresh"]  # expired entries swept on write
+
+
+@pytest.mark.asyncio
+async def test_routing_state_is_request_scoped_for_2026_requests():
+    mw = UnityInstanceMiddleware()
+    modern = _Ctx(_Connection(standalone=False, protocol_version=MODERN))
+    await mw._set_request_state(modern, "unity_instance", "A@aaaa1111")
+    assert modern._state == {} and modern._request_state["unity_instance"] == "A@aaaa1111"
+
+    legacy = _Ctx(_Connection(standalone=True, session_id="s"))
+    await mw._set_request_state(legacy, "unity_instance", "A@aaaa1111")
+    assert legacy._state["unity_instance"] == "A@aaaa1111"  # upstream behaviour for session clients
+
+
+@pytest.mark.asyncio
+async def test_anonymous_single_exchange_request_stores_nothing():
+    mw = UnityInstanceMiddleware()
+    ctx = _Ctx(_Connection(standalone=False, protocol_version=MODERN))
+    await mw.set_active_instance(ctx, "A@aaaa1111")  # must not raise: auto-select calls this too
+    assert ctx._state == {}
+    assert len(mw._client_selections) == 0
+    assert await mw.get_active_instance(ctx) is None
+
+
+# ---------------------------------------------------------------- tool + transport hints
+
+
+@pytest.mark.asyncio
+async def test_set_active_instance_tool_refuses_without_persistent_scope(monkeypatch):
+    from core.config import config
+    from services.tools import set_active_instance as tool_mod
+
+    monkeypatch.setattr(config, "transport_mode", "http")
+    monkeypatch.setattr(config, "http_remote_hosted", False)
+
+    sessions = SimpleNamespace(sessions={
+        "sid-a": SimpleNamespace(project="ProjA", hash="aaaa1111"),
+        "sid-b": SimpleNamespace(project="ProjB", hash="bbbb2222"),
+    })
+    monkeypatch.setattr(tool_mod.PluginHub, "get_sessions", AsyncMock(return_value=sessions))
+
+    fn = tool_mod.set_active_instance.fn if hasattr(tool_mod.set_active_instance, "fn") else tool_mod.set_active_instance
+    anonymous = _Ctx(_Connection(standalone=False, protocol_version=MODERN))
+    result = await fn(anonymous, "ProjA@aaaa1111")
+    assert result["success"] is False
+    assert result["hint"] == "pass_unity_instance"
+    assert result["data"]["reason"] == "no_persistent_session"
+    assert result["data"]["resolved_instance"] == "ProjA@aaaa1111"
+    assert result["data"]["available_instances"] == ["ProjA@aaaa1111", "ProjB@bbbb2222"]
+
+    identified = _Ctx(_Connection(standalone=False, protocol_version=MODERN), "client-9")
+    result = await fn(identified, "bbbb")
+    assert result["success"] is True
+    assert result["data"]["instance"] == "ProjB@bbbb2222"
+    assert result["data"]["selection_scope"] == "client"
+
+
+@pytest.mark.asyncio
+async def test_transport_hint_depends_on_whether_selection_can_persist(monkeypatch):
+    from core.config import config
+    from transport import unity_transport
+    from transport.plugin_hub import InstanceSelectionRequiredError
+
+    monkeypatch.setattr(config, "transport_mode", "http")
+    monkeypatch.setattr(config, "http_remote_hosted", False)
+
+    async def refuse(*_a, **_k):
+        raise InstanceSelectionRequiredError(available_instances=["ProjA@aaaa1111", "ProjB@bbbb2222"])
+
+    monkeypatch.setattr(unity_transport.PluginHub, "send_command_for_instance", refuse)
+
+    async def unused(*_a, **_k):
+        raise AssertionError("stdio path must not be used")
+
+    monkeypatch.setattr(unity_transport, "_current_request_can_persist_selection", lambda: True)
+    res = await unity_transport.send_with_unity_instance(unused, None, "ping", {})
+    assert res["success"] is False and res["hint"] == "select_instance"
+    assert res["data"]["available_instances"] == ["ProjA@aaaa1111", "ProjB@bbbb2222"]
+
+    monkeypatch.setattr(unity_transport, "_current_request_can_persist_selection", lambda: False)
+    res = await unity_transport.send_with_unity_instance(unused, None, "ping", {})
+    assert res["success"] is False and res["hint"] == "pass_unity_instance"
+    assert "unity_instance" in res["error"] and "ProjB@bbbb2222" in res["error"]
+
+
+@pytest.mark.parametrize(
+    "env,bind,expected",
+    [
+        ("", "127.0.0.1", "auto"),
+        ("", "localhost", "auto"),
+        ("", "::1", "auto"),
+        ("", "0.0.0.0", False),
+        ("", "::", False),
+        ("", "192.168.1.20", False),
+        ("true", "0.0.0.0", True),
+        ("auto", "0.0.0.0", "auto"),
+        ("off", "127.0.0.1", False),
+    ],
+)
+def test_host_origin_protection_follows_bind_host(monkeypatch, env, bind, expected):
+    main = pytest.importorskip("main")
+    monkeypatch.setenv("UNITY_MCP_HTTP_HOST_ORIGIN_PROTECTION", env)
+    assert main._host_origin_protection_setting(bind) == expected
+
+
+def test_current_request_can_persist_selection_defaults_to_true_outside_a_request():
+    from transport import unity_transport
+
+    assert unity_transport._current_request_can_persist_selection() is True
