+"""Live transport test for the FastMCP 4 port: real HTTP server, synthetic Unity peers, both wire eras.
+
+Runs tests/integration/live_harness.py in a subprocess (clean module space, free loopback port) and
+fails with the harness output if any check fails. Needs ``websockets`` (dev extra).
+
+Also re-runs the SDK-bound unit tests of tests/test_fastmcp4_port.py in a separate pytest process:
+in the full suite tests/integration/conftest.py replaces ``mcp`` with a stub, so they skip there.
+"""
+from __future__ import annotations
+
+import os
+import signal
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+websockets = pytest.importorskip("websockets")
+
+HERE = Path(__file__).resolve().parent
+HARNESS = HERE / "live_harness.py"
+PORT_UNIT_TESTS = HERE.parent / "test_fastmcp4_port.py"
+
+
+def _run(cmd: list[str], timeout: float) -> subprocess.CompletedProcess:
+    """subprocess.run with the child in its own process group, so a timeout also kills the
+    servers the harness started (the harness cannot clean up after SIGKILL)."""
+    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+                            start_new_session=True, cwd=HERE.parent)
+    try:
+        out, err = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        os.killpg(proc.pid, signal.SIGKILL)
+        out, err = proc.communicate()
+        pytest.fail(f"timed out after {timeout}s:\n{out[-6000:]}\n{err[-3000:]}")
+    return subprocess.CompletedProcess(cmd, proc.returncode, out, err)
+
+
+@pytest.mark.integration
+def test_live_transport_matrix():
+    proc = _run([sys.executable, str(HARNESS)], timeout=300)
+    assert proc.returncode == 0, "live harness failed:\n" + proc.stdout[-8000:] + "\n" + proc.stderr[-3000:]
+    assert "checks passed" in proc.stdout
+
+
+@pytest.mark.integration
+def test_sdk_bound_port_unit_tests_in_a_clean_process():
+    proc = _run([sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider", "-rs", str(PORT_UNIT_TESTS)], timeout=180)
+    assert proc.returncode == 0, proc.stdout[-6000:] + "\n" + proc.stderr[-3000:]
+    assert "skipped" not in proc.stdout.split("\n")[-2], "SDK-bound tests were skipped:\n" + proc.stdout[-3000:]
