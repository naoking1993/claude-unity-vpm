+    if isinstance(protocol_version, str):
+        return protocol_version not in _MODERN_PROTOCOL_VERSIONS
+    # Shims without a protocol version: fall back to "has a back-channel".
+    return bool(getattr(connection, "has_standalone_channel", False))
