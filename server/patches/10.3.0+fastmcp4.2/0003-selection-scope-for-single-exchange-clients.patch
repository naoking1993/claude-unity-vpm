+def connection_is_persistent(connection) -> bool:
+    """True when an SDK Connection lives for the whole client session.
+
+    Handshake clients (``initialize``) keep one Connection: HTTP ones carry an ``Mcp-Session-Id``
+    and stdio ones a handshake-era ``protocol_version``. 2026-07-28 clients get a born-ready
+    Connection per request, on stdio too (with a notify-only channel), so neither channel
+    presence nor ``session_id is None`` alone tells them apart; the protocol version does.
+    """
+    if getattr(connection, "session_id", None) is not None:
+        return True
